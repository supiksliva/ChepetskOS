#!/usr/bin/env bash

# ChepetskOS Package Manager - bayan (Баян)
# Внутривенная инъекция пакетов в систему

CMD="$1"
PKG="$2"

C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_PURPLE="\033[1;35m"
C_RESET="\033[0m"

detect_pm() {
    if command -v pacman >/dev/null 2>&1; then echo "pacman";
    elif command -v apt-get >/dev/null 2>&1; then echo "apt";
    elif command -v dnf >/dev/null 2>&1; then echo "dnf";
    elif command -v apk >/dev/null 2>&1; then echo "apk";
    else echo "unknown"; fi
}

PM=$(detect_pm)

case "$CMD" in
    vmazat)
        if [ -z "$PKG" ]; then
            echo -e "${C_RED}[!] Кому ставить-то? Укажи пакет: bayan vmazat <пакет>${C_RESET}"
            exit 1
        fi
        echo -e "${C_YELLOW}[~] Бежим в дежурную аптеку за '${PKG}'...${C_RESET}"
        sleep 1
        echo -e "${C_PURPLE}[~] Варим на ложке зависимости...${C_RESET}"
        sleep 1
        
        SUCCESS=0
        case "$PM" in
            pacman) sudo pacman -S --noconfirm "$PKG" && SUCCESS=1 ;;
            apt) sudo apt-get install -y "$PKG" && SUCCESS=1 ;;
            dnf) sudo dnf install -y "$PKG" && SUCCESS=1 ;;
            apk) sudo apk add "$PKG" && SUCCESS=1 ;;
            *) echo -e "${C_RED}[✖] Непонятный район, барыги не признали пакетный менеджер.${C_RESET}"; exit 1 ;;
        esac

        if [ $SUCCESS -eq 1 ]; then
            echo -e "${C_GREEN}[✔] Приход пошёл! Пакет '${PKG}' успешно пущен по венам системы.${C_RESET}"
        else
            echo -e "${C_RED}[✖] Бадяга! Менты накрыли точку у гаражей. Пакет не встал.${C_RESET}"
        fi
        ;;

    zavyazat)
        if [ -z "$PKG" ]; then
            echo -e "${C_RED}[!] Что сносить? Укажи: bayan zavyazat <пакет>${C_RESET}"
            exit 1
        fi
        echo -e "${C_RED}[!] Попытка соскочить с пакета '${PKG}'...${C_RESET}"
        sleep 1
        echo -e "${C_YELLOW}[!] Ломает кости, но удаляем...${C_RESET}"

        case "$PM" in
            pacman) sudo pacman -Rns --noconfirm "$PKG" ;;
            apt) sudo apt-get purge -y "$PKG" ;;
            dnf) sudo dnf remove -y "$PKG" ;;
            apk) sudo apk del "$PKG" ;;
        esac
        echo -e "${C_GREEN}[✔] Отпустило. Пакет '${PKG}' смыт в унитаз.${C_RESET}"
        ;;

    lomka)
        echo -e "${C_RED}[!] ДИКИЕ КУМАРЫ! Бежим за дозой обновлений для всей системы...${C_RESET}"
        case "$PM" in
            pacman) sudo pacman -Syu --noconfirm ;;
            apt) sudo apt-get update && sudo apt-get upgrade -y ;;
            dnf) sudo dnf upgrade -y ;;
            apk) sudo apk update && sudo apk upgrade ;;
        esac
        echo -e "${C_GREEN}[✔] Все дозы получены. Система попустилась.${C_RESET}"
        ;;

    shmon)
        if [ -z "$PKG" ]; then
            echo "Что ищем? bayan shmon <запрос>"
            exit 1
        fi
        echo -e "${C_YELLOW}[~] Шустрим по закоулкам репозиториев в поисках '${PKG}'...${C_RESET}"
        case "$PM" in
            pacman) pacman -Ss "$PKG" ;;
            apt) apt-cache search "$PKG" ;;
            dnf) dnf search "$PKG" ;;
            apk) apk search "$PKG" ;;
        esac
        ;;

    *)
        echo -e "${C_PURPLE}Чепецкий Пакетный Менеджер 'bayan' v1.0 (Только хардкор)${C_RESET}"
        echo "Команды:"
        echo "  bayan vmazat <пакет>   - поставить пакет (внутривенно)"
        echo "  bayan zavyazat <пакет> - удалить пакет и зависимости (соскочить)"
        echo "  bayan lomka            - накатить все доступные обновления"
        echo "  bayan shmon <пакет>    - найти пакет в базах"
        ;;
esac
