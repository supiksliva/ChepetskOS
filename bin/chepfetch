#!/usr/bin/env bash

# ChepetskOS System Informer - chepfetch
# Выводит сводку по угару, выхлопам КЧХК и состоянию печени

C_RESET="\033[0m"
C_RED="\033[1;31m"
C_YELLOW="\033[1;33m"
C_GRAY="\033[1;30m"
C_PURPLE="\033[1;35m"
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"

USER="$(whoami)"
HOST="$(hostname 2>/dev/null || echo "podjezd-6")"
UPTIME="$(uptime -p 2>/dev/null | sed 's/up //')"
[ -z "$UPTIME" ] && UPTIME="3 дня без сна"
RAM="$(free -h 2>/dev/null | awk '/Mem:/ {print $3 " / " $2}')"
[ -z "$RAM" ] && RAM="всё пропито"
SWAP="$(free -h 2>/dev/null | awk '/Swap:/ {print $3}')"

cat << EOF
${C_RED}         ===|===>------------.      ${C_PURPLE}${USER}${C_RESET}@${C_RED}${HOST}${C_RESET}
${C_GRAY}        /   |                |      ${C_GRAY}----------------------------------------${C_RESET}
${C_GRAY}       | [###]               |      ${C_YELLOW}Дистрибутив:${C_RESET}   ChepetskOS (Toxic Krokodil Core)
${C_GRAY}       | [###]               |      ${C_YELLOW}Локация:${C_RESET}       Подъезд на Боёво (лампочка разбита)
${C_RED}        \___|________________/      ${C_YELLOW}Состояние:${C_RESET}     ${C_RED}Ломка 3-й степени + жуткий сушняк${C_RESET}
${C_GRAY}            |                       ${C_YELLOW}Атмосфера:${C_RESET}     14.8 ПДК аммиака КЧХК, синий туман
${C_GRAY}         .-' '-.                    ${C_YELLOW}Запой:${C_RESET}         ${UPTIME}
${C_GRAY}        /  777  \\                   ${C_YELLOW}Печень (RAM):${C_RESET}  ${RAM}
${C_GRAY}       | ФУНФЫРЬ |                  ${C_YELLOW}Ломбард (SWAP):${C_RESET}${SWAP} заложено до получки
${C_GRAY}       |_________|                  ${C_YELLOW}Оболочка:${C_RESET}      gopsh (понятия 1998)
${C_RED}   [ ОСТОРОЖНО: ВЫБРОС ]${C_RESET}            ${C_YELLOW}Крыша:${C_RESET}         Участковый Михалыч за сотку
EOF
