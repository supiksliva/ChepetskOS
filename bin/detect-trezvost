#!/usr/bin/env bash

# ChepetskOS Security Checker - detect-trezvost
# Проверка карманов пользователя на наличие буржуйского и трезвого софта

C_RED="\033[1;31m"
C_YELLOW="\033[1;33m"
C_GREEN="\033[1;32m"
C_RESET="\033[0m"

TREZVOE_PO=(
    "code:VS Code (хипстер столичный, на заводе пиши в nano)"
    "spotify:Spotify (врубай магнитофон Весна и радио Дача)"
    "discord:Discord (выходи на лавку к пацанам базарить)"
    "slack:Slack (офисный планктон детектирован)"
    "telegram-desktop:Telegram (переписки в чатиках вместо стрелки за гаражами)"
    "google-chrome:Google Chrome (жрет память почище крокодила)"
)

MODE="$1"

echo -e "${C_RED}[!] ОБЛАВА ГОПНИКОВ В ПОДЪЕЗДЕ! Проверяем карманы на трезвый софт...${C_RESET}"
sleep 1

FOUND=0

for item in "${TREZVOE_PO[@]}"; do
    bin_name="${item%%:*}"
    desc="${item#*:}"

    if which "$bin_name" >/dev/null 2>&1; then
        echo -e "${C_RED}[ПАЛЕВО ОБНАРУЖЕНО]:${C_RESET} ${C_YELLOW}$bin_name${C_RESET} -> $desc"
        FOUND=1
        if [ "$MODE" == "--otzhat" ]; then
            echo -e "${C_RED}[-] Отжимаем телефон и сносим $bin_name...${C_RESET}"
            sudo pacman -Rns --noconfirm "$bin_name" 2>/dev/null || sudo apt-get purge -y "$bin_name" 2>/dev/null
        fi
    fi
done

if [ $FOUND -eq 0 ]; then
    echo -e "${C_GREEN}[✔] Карманы чисты: только семечки, зажигалка и фунфырик. Свой пацан, проходи.${C_RESET}"
else
    echo -e "${C_RED}[☠] ВЫВОД: Слишком много буржуйского софта! Запусти 'detect-trezvost --otzhat', чтобы очиститься.${C_RESET}"
    exit 1
fi
