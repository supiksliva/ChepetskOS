#!/usr/bin/env bash

# ChepetskOS Daemon Controller - nalivayka
# Управление демонами по понятиям рюмочной на вокзале

ACTION="$1"
SERVICE="$2"

C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RESET="\033[0m"

if [ -z "$ACTION" ]; then
    echo "Чепецкая Наливайка (Службы и процессы):"
    echo "  nalivayka nalyat <сервис>   - запустить процесс (налить 150г)"
    echo "  nalivayka otrubit <сервис>  - остановить службу (дать по печени)"
    echo "  nalivayka belochka <сервис> - статус (проверить на белку)"
    echo "  nalivayka do-dna <сервис>   - перезапустить службу (накатить до дна)"
    exit 1
fi

case "$ACTION" in
    nalyat)
        echo -e "${C_YELLOW}[+] Наливаем 150 грамм боярышника службе '${SERVICE}'...${C_RESET}"
        sudo systemctl start "$SERVICE"
        echo -e "${C_GREEN}[✔] Служба накатила и пошла орать песни под гитару.${C_RESET}"
        ;;
    otrubit)
        echo -e "${C_RED}[-] Выписали с ноги по печени службе '${SERVICE}'...${C_RESET}"
        sudo systemctl stop "$SERVICE"
        echo -e "${C_GREEN}[✔] Служба отключилась и упала лицом в асфальт.${C_RESET}"
        ;;
    belochka)
        echo -e "${C_YELLOW}[!] Вызываем фельдшера. Проверка состояния '${SERVICE}':${C_RESET}"
        sudo systemctl status "$SERVICE"
        ;;
    do-dna)
        echo -e "${C_RED}[☠] ДО ДНА! Опрокидываем залпом и перезапускаем '${SERVICE}'...${C_RESET}"
        sudo systemctl restart "$SERVICE"
        echo -e "${C_GREEN}[✔] Второе дыхание открылось.${C_RESET}"
        ;;
    *)
        echo "Куда прешь? Нет такой команды в наливайке."
        ;;
esac
